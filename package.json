{
  "name": "oppositelab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "next build",
    "build:capacitor": "cross-env CAPACITOR_BUILD=true next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "cap:init": "npx cap init",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "mobile:build": "npm run build:capacitor && npm run cap:sync",
    "mobile:ios": "npm run build:capacitor && npm run cap:sync:ios && npm run cap:open:ios",
    "mobile:android": "npm run build:capacitor && npm run cap:sync:android && npm run cap:open:android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@heroicons/react": "^2.2.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "geist": "^1.4.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "mongodb": "^7.7.0",
    "next": "^15.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "resend": "^6.33.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/node": "20.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.2"
  }
}
